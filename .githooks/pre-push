#!/bin/sh
# Validate the immutable commit being pushed, not the shared dirty worktree.
set -eu

zero=0000000000000000000000000000000000000000
repo_root=$(git rev-parse --show-toplevel)

guard_corpus_evidence() {
    local_sha=$1
    remote_sha=$2
    comparison=$remote_sha
    if [ "$comparison" = "$zero" ] || ! git -C "$repo_root" cat-file -e "$comparison^{commit}"; then
        comparison=$(git -C "$repo_root" merge-base origin/main "$local_sha" 2>/dev/null || true)
    fi
    if [ -n "$comparison" ]; then
        changed=$(git -C "$repo_root" diff --name-only "$comparison" "$local_sha" -- \
            ':(glob)corpus/identity/**' \
            ':(glob)corpus/records/*/artifacts/**')
    else
        changed=$(git -C "$repo_root" ls-tree -r --name-only "$local_sha" -- \
            ':(glob)corpus/identity/**' \
            ':(glob)corpus/records/*/artifacts/**')
    fi
    if [ -n "$changed" ] && [ "${CICADA_CORPUS_MAINTENANCE:-}" != "1" ]; then
        echo "pre-push: immutable corpus evidence changed:" >&2
        echo "$changed" | sed -n '1,12p' >&2
        echo "pre-push: authorized corpus maintenance sets CICADA_CORPUS_MAINTENANCE=1" >&2
        return 1
    fi
}

validate_commit() {
    local_sha=$1
    remote_sha=$2
    guard_corpus_evidence "$local_sha" "$remote_sha"
    scratch=$(mktemp -d "${TMPDIR:-/tmp}/cicada-pre-push.XXXXXX")
    checkout=$scratch/tree

    cleanup() {
        git -C "$repo_root" worktree remove --force "$checkout" >/dev/null 2>&1 || true
        rmdir "$scratch" >/dev/null 2>&1 || true
    }
    trap cleanup EXIT HUP INT TERM

    if [ "$remote_sha" != "$zero" ] && git -C "$repo_root" cat-file -e "$remote_sha^{commit}"; then
        git -C "$repo_root" diff --check "$remote_sha" "$local_sha"
    else
        git -C "$repo_root" show --check --format= "$local_sha" >/dev/null
    fi

    git -C "$repo_root" worktree add --detach --quiet "$checkout" "$local_sha"
    echo "pre-push: validating $local_sha in an isolated worktree"
    (
        cd "$checkout"
        python3 -m solver.corpus
        python3 -m unittest discover -s tests
        if command -v ruff >/dev/null 2>&1; then
            ruff check solver tests
        elif command -v pipx >/dev/null 2>&1; then
            pipx run ruff==0.15.20 check solver tests
        else
            echo "pre-push: ruff or pipx is required" >&2
            exit 1
        fi
    )

    cleanup
    trap - EXIT HUP INT TERM
}

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    case "$remote_ref" in
        refs/heads/*) validate_commit "$local_sha" "$remote_sha" ;;
    esac
done
